        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "POST /api/auth/register \u2014 body {name, email, password}. Creates user, 409 if email exists. Email triggers BullMQ welcome mail (check /api/jobs). Test creates random email if you change it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Grub Tester\",\n  \"email\": \"{{dynEmail}}\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "let e = `grub_${Date.now()}@example.com`;",
                  "pm.collectionVariables.set('dynEmail', e);",
                  "console.log('Register email', e);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Register 200/201', () => pm.expect(pm.response.code).to.be.oneOf([200,201,409]));",
                  "let j = pm.response.json();",
                  "if(j.data && j.data.id) pm.collectionVariables.set('newUserId', j.data.id);",
                  "console.log(j);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login - Alice (Acme Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "POST /api/auth/login \u2014 body {email, password}. Sets httpOnly cookie 'tokens' {access_token, refresh_token}. Response also returns accessToken/refreshToken. Postman auto-stores cookie for subsequent requests. This login maps to org acme (b237e9cc...). Subsequent Project/Task calls need that orgId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@taskflow.dev\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login 200\", () => pm.response.to.have.status(200));",
                  "let j = pm.response.json();",
                  "if(j.data && j.data.accessToken) {",
                  "  pm.collectionVariables.set(\"accessToken\", j.data.accessToken);",
                  "  pm.collectionVariables.set(\"refreshToken\", j.data.refreshToken);",
                  "  if(j.data.user) pm.collectionVariables.set(\"userId\", j.data.user.id);",
                  "}",
                  "console.log(\"Login response:\", j);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
